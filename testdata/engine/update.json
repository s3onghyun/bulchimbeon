{
  "checkIntervalSeconds": 86400,
  "maxResponseBytes": 1048576,
  "latestReleaseAPI": "https://api.github.com/repos/s3onghyun/bulchimbeon/releases/latest",
  "versions": [
    {"name": "plain", "input": "0.10.2", "expect": "0.10.2"},
    {"name": "tag prefix", "input": "v0.10.2", "expect": "0.10.2"},
    {"name": "surrounding whitespace", "input": " 1.0.0\n", "expect": "1.0.0"},
    {"name": "prerelease", "input": "1.0.0-rc.1", "expect": "1.0.0-rc.1"},
    {"name": "hyphen inside a prerelease identifier", "input": "1.0.0-x-y.1", "expect": "1.0.0-x-y.1"},
    {"name": "build metadata is dropped", "input": "1.0.0+build.5", "expect": "1.0.0"},
    {"name": "prerelease with build metadata", "input": "1.0.0-beta+exp.sha.5114f85", "expect": "1.0.0-beta"},
    {"name": "git describe dev build compares as its tag", "input": "0.10.2-3-gabc1234", "expect": "0.10.2"},
    {"name": "dirty git describe build", "input": "0.10.2-3-gabc1234-dirty", "expect": "0.10.2"},
    {"name": "git describe after a prerelease tag", "input": "1.0.0-rc.1-2-g0123abc", "expect": "1.0.0-rc.1"},
    {"name": "untagged build", "input": "dev", "expect": null},
    {"name": "empty", "input": "", "expect": null},
    {"name": "Debian CI version", "input": "0.0.0~ci", "expect": null},
    {"name": "two parts", "input": "1.2", "expect": null},
    {"name": "four parts", "input": "1.2.3.4", "expect": null},
    {"name": "not a number", "input": "1.2.x", "expect": null},
    {"name": "leading zero", "input": "01.2.3", "expect": null},
    {"name": "leading zero in a numeric prerelease", "input": "1.2.3-01", "expect": null},
    {"name": "empty prerelease", "input": "1.2.3-", "expect": null},
    {"name": "empty prerelease identifier", "input": "1.2.3-rc..1", "expect": null},
    {"name": "invalid prerelease character", "input": "1.2.3-rc_1", "expect": null},
    {"name": "empty build metadata", "input": "1.2.3+", "expect": null},
    {"name": "leading hyphen", "input": "-1.2.3", "expect": null},
    {"name": "too many digits", "input": "1234567890.0.0", "expect": null}
  ],
  "compare": [
    {"a": "0.10.2", "b": "0.10.10", "expect": -1},
    {"a": "0.9.9", "b": "0.10.0", "expect": -1},
    {"a": "1.0.0", "b": "0.99.99", "expect": 1},
    {"a": "v1.0.0", "b": "1.0.0", "expect": 0},
    {"a": "1.0.0+a", "b": "1.0.0+b", "expect": 0},
    {"a": "0.10.2-3-gabc1234", "b": "0.10.2", "expect": 0},
    {"a": "1.0.0-alpha", "b": "1.0.0-alpha.1", "expect": -1},
    {"a": "1.0.0-alpha.1", "b": "1.0.0-alpha.beta", "expect": -1},
    {"a": "1.0.0-alpha.beta", "b": "1.0.0-beta", "expect": -1},
    {"a": "1.0.0-beta", "b": "1.0.0-beta.2", "expect": -1},
    {"a": "1.0.0-beta.2", "b": "1.0.0-beta.11", "expect": -1},
    {"a": "1.0.0-beta.11", "b": "1.0.0-rc.1", "expect": -1},
    {"a": "1.0.0-rc.1", "b": "1.0.0", "expect": -1},
    {"a": "1.0.0-2", "b": "1.0.0-10", "expect": -1},
    {"a": "1.0.0-10", "b": "1.0.0-a", "expect": -1},
    {"a": "1.0.0-Z", "b": "1.0.0-a", "expect": -1},
    {"a": "1.0.0-20261029123456", "b": "1.0.0-20261029123457", "expect": -1}
  ],
  "releases": [
    {"name": "ordinary release",
     "json": {"tag_name": "v0.11.0", "draft": false, "prerelease": false, "body": "**[English](#english)** · **[한국어](#한국어)**\n\n## English\n"},
     "expect": {"version": "0.11.0", "criticalBelow": null}},
    {"name": "critical marker on the first line",
     "json": {"tag_name": "v0.10.2", "draft": false, "prerelease": false, "body": "<!-- bulchimbeon: critical -->\n**[English](#english)** · **[한국어](#한국어)**\n"},
     "expect": {"version": "0.10.2", "criticalBelow": "0.10.2"}},
    {"name": "spacing and case inside the marker do not matter",
     "json": {"tag_name": "v0.10.2", "body": "notes\n   <!--Bulchimbeon : CRITICAL-->  \nmore"},
     "expect": {"version": "0.10.2", "criticalBelow": "0.10.2"}},
    {"name": "critical below an earlier version",
     "json": {"tag_name": "v0.11.0", "body": "<!-- bulchimbeon: critical below 0.10.2 -->\nnotes"},
     "expect": {"version": "0.11.0", "criticalBelow": "0.10.2"}},
    {"name": "the widest of several markers wins",
     "json": {"tag_name": "v0.11.0", "body": "<!-- bulchimbeon: critical below 0.9.0 -->\n<!-- bulchimbeon: critical below v0.10.2 -->\n"},
     "expect": {"version": "0.11.0", "criticalBelow": "0.10.2"}},
    {"name": "plain critical covers every older version",
     "json": {"tag_name": "v0.11.0", "body": "<!-- bulchimbeon: critical below 0.9.0 -->\n<!-- bulchimbeon: critical -->\n"},
     "expect": {"version": "0.11.0", "criticalBelow": "0.11.0"}},
    {"name": "CRLF line endings",
     "json": {"tag_name": "v0.10.2", "body": "<!-- bulchimbeon: critical -->\r\n## English\r\n"},
     "expect": {"version": "0.10.2", "criticalBelow": "0.10.2"}},
    {"name": "a marker quoted inside a sentence is not a marker",
     "json": {"tag_name": "v0.11.0", "body": "Add `<!-- bulchimbeon: critical -->` to the notes to flag a release."},
     "expect": {"version": "0.11.0", "criticalBelow": null}},
    {"name": "malformed markers are ignored",
     "json": {"tag_name": "v0.11.0", "body": "<!-- bulchimbeon: critical below -->\n<!-- bulchimbeon: critical below banana -->\n<!-- bulchimbeon: urgent -->\n<!-- critical -->\n<!-- bulchimbeon: critical please -->"},
     "expect": {"version": "0.11.0", "criticalBelow": null}},
    {"name": "no body",
     "json": {"tag_name": "v0.11.0"},
     "expect": {"version": "0.11.0", "criticalBelow": null}},
    {"name": "null body",
     "json": {"tag_name": "v0.11.0", "body": null},
     "expect": {"version": "0.11.0", "criticalBelow": null}},
    {"name": "draft is ignored",
     "json": {"tag_name": "v0.11.0", "draft": true, "body": ""},
     "expect": null},
    {"name": "prerelease is ignored",
     "json": {"tag_name": "v0.11.0-rc.1", "prerelease": true, "body": ""},
     "expect": null},
    {"name": "tag that is not a version",
     "json": {"tag_name": "nightly", "body": ""},
     "expect": null},
    {"name": "missing tag",
     "json": {"message": "Not Found", "documentation_url": "https://docs.github.com/rest"},
     "expect": null},
    {"name": "not an object",
     "json": [{"tag_name": "v0.11.0"}],
     "expect": null},
    {"name": "not JSON",
     "text": "<html>rate limited</html>",
     "expect": null}
  ],
